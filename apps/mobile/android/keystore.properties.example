# ⚠ THIS FILE IS TRACKED BY GIT. Never put a real password in it.
#
# It is a template. The real values belong in keystore.properties — same folder,
# no .example — which is gitignored and which the build actually reads.
#
# storeFile is an absolute path deliberately: keep the .jks OUTSIDE the repo so
# that no `git add -f`, no zip of the working tree and no accidental branch can
# ever carry it. Forward slashes work on Windows here.
#
# Losing this key means the Play listing can never be updated again — a new
# listing, a new URL, and every installed copy stranded. Back the .jks up
# somewhere that survives this machine dying, and store the passwords in a
# password manager, not in this file's neighbourhood.

storeFile=C:/Users/Danie/keys/kitchenboard-upload.jks
storePassword=
keyAlias=kitchenboard
keyPassword=
