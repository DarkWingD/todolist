# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Test / coverage
coverage/

# Local data & backups
backups/
pgdata/

# Backup secrets (created on the host, never committed)
backup.env
.backup-passphrase
scripts/

# PWA generated
apps/web/dev-dist/

# Claude Code personal settings
.claude/settings.local.json

# Capacitor / Android — the generated android/ project IS committed (it holds
# icons, the manifest and signing config), but its build output is not.
android/.gradle/
android/local.properties
android/.idea/
android/app/release/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/.idea/
apps/mobile/android/app/release/

# Signing keys must never be committed. Losing the upload key is recoverable
# through Play App Signing; committing it is not.
*.jks
*.keystore
keystore.properties
