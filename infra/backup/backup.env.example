# Copy to backup.env on the host and fill in. Keep backup.env and the passphrase
# file private (chmod 600) and NEVER commit them.

COMPOSE_DIR=/home/danielwood/todolist
BACKUP_DIR=/home/danielwood/todolist/backups
RETENTION_DAYS=21

# Symmetric encryption passphrase (AES256). Losing this file = unrecoverable backups,
# so ALSO store the passphrase somewhere safe and off the box.
GPG_PASSPHRASE_FILE=/home/danielwood/todolist/scripts/.backup-passphrase

POSTGRES_USER=todolist
POSTGRES_DB=todolist

# ── Off-box destination (the provider interface) ──
# An rclone remote:path. Switch providers by changing this to another remote
# (e.g. s3bucket:todolist, nas:todolist, b2:todolist) after `rclone config`.
# Empty = local backups only.
RCLONE_REMOTE=gdrive:todolist-backups
RCLONE_BIN=/home/danielwood/.local/bin/rclone
