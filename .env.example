# ─── Copy to .env and fill in. Never commit .env. ───

# Postgres
POSTGRES_USER=todolist
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=todolist
# Used by app/worker/db to connect. In Docker Compose, host is "postgres".
DATABASE_URL=postgres://todolist:change-me-in-prod@localhost:5432/todolist

# API server
API_PORT=8787
# Public origin of the web app (used for magic-link URLs and CORS)
WEB_ORIGIN=http://localhost:5173
# Secret for signing sessions / tokens (generate: openssl rand -hex 32)
AUTH_SECRET=replace-with-64-char-hex

# Resend (email: magic links + reminders)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender. Must be on a domain with SPF/DKIM/DMARC set up in Resend.
EMAIL_FROM="ToDoList <hello@yourdomain.tld>"

# Cloudflare Tunnel (used by the cloudflared container in production)
CLOUDFLARE_TUNNEL_TOKEN=

# Web (Vite) — must be prefixed with VITE_ to be exposed to the client
VITE_API_URL=http://localhost:8787
